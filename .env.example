# =============================================================================
# X-OPS CASEPLAY — Environment Configuration TEMPLATE
# Copy this to .env and fill in your real values.
# =============================================================================
#
# ⚠️  DO NOT commit .env to source control.
#     This file (.env.example) IS safe to commit.
#
# 🔒 SECURITY: SUPABASE_SECRET_KEY must ONLY be used server-side (lib/supabase.js).
#     It must never appear in frontend JavaScript, API responses, or logs.
# =============================================================================

# Server Port
PORT=3000

# Default Admin PIN for new games
DEFAULT_ADMIN_PIN=1234

# Environment
NODE_ENV=development

# =============================================================================
# SUPABASE CONFIGURATION
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api
# =============================================================================

# Your Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable/anon key (safe to expose publicly if needed)
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE

# 🔒 SECRET key — SERVER-SIDE ONLY. Never expose to browser.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY_HERE
